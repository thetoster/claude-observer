# Raspberry Pi Pico / Pico 2 — dostep bez sudo
# BOOTSEL mass-storage: RP2040 0x0003, RP2350 0x000f
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0003", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="000f", MODE="0666", TAG+="uaccess"
# picotool / debug (dowolny produkt Raspberry Pi)
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", MODE="0666", TAG+="uaccess"
# CDC serial -> stabilny alias /dev/claude-observer
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", SYMLINK+="claude-observer", MODE="0666", TAG+="uaccess"
